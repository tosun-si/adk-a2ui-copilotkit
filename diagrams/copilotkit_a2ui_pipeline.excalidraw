    {
      "id": "bridge-code",
      "type": "text",
      "x": 875,
      "y": 180,
      "width": 361.2,
      "height": 350.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
