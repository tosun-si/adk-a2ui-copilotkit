      "link": null,
      "locked": false,
      "text": "createCatalog(definitions, renderers, {\n  catalogId: \"football_catalog\",\n  includeBasicCatalog: true, // Column, Text…\n})\n\nChart: {\n  chartType: bar | line | pie\n           | radar | heatmap,\n  xKey, yKeys, data,\n}  →  <EChart spec={…} />",
