# Auto-discovered by `adk deploy agent_engine` (the agent folder's .env is
# bundled as the engine's env_vars) AND by `adk web` locally.
# These are runtime env vars for Agent Engine (Agent Platform).

# Activates Agent Engine telemetry (`adk api_server --otel_to_cloud` inside the
# engine) → populates the "Traces" / "Observability" tabs. The deploy script
# also passes `--otel_to_cloud` explicitly, which forces this to true.
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Capture prompts / responses / tool args (the generated SQL, the BQ rows) in
# the spans. `adk deploy --otel_to_cloud` defaults ADK's flag to FALSE when it
# is absent from .env — that is why traces looked empty/useless before.
# WARNING: captures user input verbatim — fine here, the dataset is public
# (Qatar 2022 stats). Drop both for any deployment handling PII.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
